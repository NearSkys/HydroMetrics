# =========================================================
# HydroMetrics O&M — Template de Variáveis de Ambiente
# Para configurar o ambiente local ou de produção:
#   cp .env.example .env
# Em seguida, preencha as variáveis com valores seguros.
# =========================================================

# Ambiente da Aplicação
NODE_ENV=development
PORT=3000

# Conexão com o Banco de Dados PostgreSQL
# O usuário ast_app_user opera sob o Princípio do Menor Privilégio (DML restrito)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ast_db
DB_USER=ast_app_user
DB_PASSWORD=sua_senha_segura_para_o_app

# Senha do Superusuário PostgreSQL (Utilizado apenas pelo Docker Compose)
POSTGRES_ROOT_PASSWORD=sua_senha_segura_para_root


JWT_SECRET=sua_chave_jwt_secreta_aqui_minimo_32_bytes
