# Dependências do Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.backup

# Variáveis de Ambiente e Segredos (NUNCA comitar)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
secrets/
*.pem
*.key

# Documentações internas de projeto e prompts
docs_projeto/
docs/

# Relatórios e Cobertura de Testes
coverage/
.nyc_output/

# Logs e Arquivos Temporários
logs/
*.log

# Arquivos de Sistema Operacional e IDEs
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Volumes locais persistentes (caso montados em pasta relativa)
postgres_data/

# Arquivos temporários de design e pacotes
public/hydrometrics-visual-refresh/
*.zip
generate_dossier.js
projeto.md